    {
      "parameters": {
        "jsCode": "// 1. Get the raw output text from the AI Agent node\n// CORRECTED: Changed .response to .output based on your node's actual data structure\nconst agentOutput = $input.first().json.output;\n\n// 2. Check if the output is valid before proceeding\nif (!agentOutput || typeof agentOutput !== 'string' || agentOutput.trim().length === 0) {\n    console.error(\"AI Agent returned no valid string output.\");\n    // Return an error object to prevent flow halt, but log the failure\n    return [{ json: { error: \"AI Output Empty\", raw: agentOutput } }];\n}\n\n// 3. Proceed with JSON extraction and parsing\nconst jsonMatch = agentOutput.match(/\\{[\\s\\S]*\\}/);\n\nif (jsonMatch && jsonMatch[0]) {\n    try {\n        const parsedJson = JSON.parse(jsonMatch[0]);\n        // Successfully parsed and structured data\n        return [{ json: parsedJson }];\n    } catch (e) {\n        console.error(\"Failed to parse final JSON:\", e);\n        // Failed parsing due to bad JSON format\n        return [{ json: { error: \"JSON Parsing Failed\", raw: jsonMatch[0] } }];\n    }\n} else {\n    // LLM returned text, but no valid JSON block was found (Regex failure)\n    return [{ json: { error: \"No JSON Structure Found\", raw: agentOutput } }];\n}"
      },
